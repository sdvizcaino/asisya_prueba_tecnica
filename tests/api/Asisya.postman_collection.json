              "raw": "{\n  \"usuarioId\": \"USR999\",\n  \"tipoAsistencia\": \"medico_domicilio\",\n  \"direccion\": \"Cra 12 #34-56\",\n  \"fecha\": \"2025-08-02\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
