            },
            "description": "Payload EXACTO del PDF del enunciado (usuarioId fijo y fecha pasada, sin tocar ni un carácter): confirma que ese payload textual sigue siendo válido contra el contrato vigente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const schema = {",
                  "  type: 'object',",
                  "  required: ['solicitudId', 'estado', 'mensaje', 'usuarioId', 'tipoAsistencia', 'direccionRegistrada', 'fechaCreacion', 'duplicada'],",
                  "  properties: {",
                  "    solicitudId: { type: 'string', pattern: '^SOL-\\\\d{8}-\\\\d{4}$' },",
                  "    estado: { type: 'string' },",
                  "    mensaje: { type: 'string' },",
                  "    usuarioId: { type: 'string' },",
                  "    tipoAsistencia: { type: 'string' },",
                  "    direccionRegistrada: { type: 'string' },",
                  "    fechaCreacion: { type: 'string' },",
                  "    duplicada: { type: 'boolean' }",
                  "  }",
                  "};",
                  "",
                  "pm.test('Solicitud médico domiciliario creada con 201 y schema válido', function () {",
                  "  pm.response.to.have.status(201);",
